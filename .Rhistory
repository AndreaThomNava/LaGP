# Fit a Matern model (“Mat”) to the sample variogram using different values
# for kappa (e.g., 0.3 and 4), and plot the resulting models with the sample
# variogram.
v.fit = fit.variogram(vv, vgm(1, "Mat", 50000, kappa = 1.5))
plot(vv, v.fit)
